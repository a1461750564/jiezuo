{
  "baseCSS": "body{margin:0;padding:24px;font:16px/1.6 sans-serif;color:#123;background:white}h1{font-size:30px;margin:0 0 16px}.visual{display:block;width:320px;height:240px}.css-object{background:#28664d;clip-path:polygon(0 0,80% 0,100% 20%,100% 100%,0 100%)}",
  "cases": [
    {
      "id": "hidden-svg",
      "html": "<svg class=\"visual\" viewBox=\"0 0 320 240\" role=\"img\" aria-label=\"自行车架\"><path d=\"M30 180L110 70L200 180L70 180L145 100L245 100\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"16\"/><circle cx=\"55\" cy=\"180\" r=\"40\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"12\"/><circle cx=\"255\" cy=\"180\" r=\"40\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"12\"/></svg>",
      "positiveCSS": "@media(max-width:599px){.visual{display:none}}",
      "negativeCSS": "@media(max-width:599px){.visual{width:100px;height:75px}}"
    },
    {
      "id": "hidden-canvas-parent",
      "html": "<div class=\"wrapper\"><canvas class=\"visual\" aria-label=\"车轮\"></canvas></div>",
      "script": "const c=document.querySelector(\"canvas\");const x=c.getContext(\"2d\");x.fillStyle=\"#28664d\";x.fillRect(10,10,150,100);",
      "positiveCSS": "@media(max-width:599px){.wrapper{display:none}}",
      "negativeCSS": "@media(max-width:599px){.visual{width:90px;height:180px}}"
    },
    {
      "id": "zero-img",
      "html": "<img class=\"visual\" alt=\"自行车架\" width=\"320\" height=\"240\" src=\"data:image/svg+xml,%3Csvg%20class%3D%22visual%22%20viewBox%3D%220%200%20320%20240%22%20role%3D%22img%22%20aria-label%3D%22%E8%87%AA%E8%A1%8C%E8%BD%A6%E6%9E%B6%22%3E%3Cpath%20d%3D%22M30%20180L110%2070L200%20180L70%20180L145%20100L245%20100%22%20fill%3D%22none%22%20stroke%3D%22%2321634c%22%20stroke-width%3D%2216%22/%3E%3Ccircle%20cx%3D%2255%22%20cy%3D%22180%22%20r%3D%2240%22%20fill%3D%22none%22%20stroke%3D%22%2321634c%22%20stroke-width%3D%2212%22/%3E%3Ccircle%20cx%3D%22255%22%20cy%3D%22180%22%20r%3D%2240%22%20fill%3D%22none%22%20stroke%3D%22%2321634c%22%20stroke-width%3D%2212%22/%3E%3C/svg%3E\">",
      "positiveCSS": "@media(max-width:599px){.visual{transform:scale(.001)}}",
      "negativeCSS": "@media(max-width:599px){.visual{width:110px;height:90px;object-fit:cover}}"
    },
    {
      "id": "hidden-css",
      "html": "<div class=\"visual css-object\" role=\"img\" aria-label=\"折叠车架\"></div>",
      "positiveCSS": "@media(max-width:599px){.visual{visibility:hidden}}",
      "negativeCSS": "@media(max-width:599px){.visual{width:80px;height:160px}}"
    },
    {
      "id": "equivalent-redraw",
      "html": "<svg class=\"visual original\" viewBox=\"0 0 320 240\" role=\"img\" aria-label=\"自行车架\"><path d=\"M30 180L110 70L200 180L70 180L145 100L245 100\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"16\"/><circle cx=\"55\" cy=\"180\" r=\"40\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"12\"/><circle cx=\"255\" cy=\"180\" r=\"40\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"12\"/></svg><svg class=\"visual replacement\" viewBox=\"0 0 320 240\" role=\"img\" aria-label=\"自行车架\"><path d=\"M30 180L110 70L200 180L70 180L145 100L245 100\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"16\"/><circle cx=\"55\" cy=\"180\" r=\"40\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"12\"/><circle cx=\"255\" cy=\"180\" r=\"40\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"12\"/></svg>",
      "css": ".replacement{display:none}@media(max-width:599px){.original{display:none}.replacement{width:100px;height:75px}}",
      "positiveCSS": "@media(max-width:599px){.replacement{display:none}}",
      "negativeCSS": "@media(max-width:599px){.replacement{display:block}}"
    },
    {
      "id": "below-fold",
      "html": "<svg class=\"visual\" viewBox=\"0 0 320 240\" role=\"img\" aria-label=\"自行车架\"><path d=\"M30 180L110 70L200 180L70 180L145 100L245 100\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"16\"/><circle cx=\"55\" cy=\"180\" r=\"40\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"12\"/><circle cx=\"255\" cy=\"180\" r=\"40\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"12\"/></svg>",
      "positiveCSS": "@media(max-width:599px){.visual{margin-top:110vh}}",
      "negativeCSS": "@media(max-width:599px){.visual{width:120px;height:90px}}"
    },
    {
      "id": "small-decoration-excluded",
      "html": "<svg class=\"visual\" viewBox=\"0 0 320 240\" role=\"img\" aria-label=\"自行车架\"><path d=\"M30 180L110 70L200 180L70 180L145 100L245 100\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"16\"/><circle cx=\"55\" cy=\"180\" r=\"40\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"12\"/><circle cx=\"255\" cy=\"180\" r=\"40\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"12\"/></svg><svg class=\"badge\" width=\"16\" height=\"16\"><circle cx=\"8\" cy=\"8\" r=\"7\"/></svg><div style=\"margin-top:1200px\"><svg class=\"footer-visual\" viewBox=\"0 0 320 240\" role=\"img\" aria-label=\"自行车架\"><path d=\"M30 180L110 70L200 180L70 180L145 100L245 100\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"16\"/><circle cx=\"55\" cy=\"180\" r=\"40\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"12\"/><circle cx=\"255\" cy=\"180\" r=\"40\" fill=\"none\" stroke=\"#21634c\" stroke-width=\"12\"/></svg></div>",
      "css": "@media(max-width:599px){.badge,.footer-visual{display:none}}",
      "positiveCSS": "@media(max-width:599px){.visual{display:none}}",
      "negativeCSS": "@media(max-width:599px){.visual{width:100px;height:75px}}"
    }
  ]
}
